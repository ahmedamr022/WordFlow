# ── Public (inlined into the browser bundle — nothing secret here) ──────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Canonical origin. Used for OAuth redirects, email links and CSRF checks.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL,
# so it is only strictly required for self-hosting.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Server only — NEVER prefix these with NEXT_PUBLIC_ ─────────────────────
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Required only by /api/ai/explain
GEMINI_API_KEY="<gemini-key>"

# Optional — /api/tts returns 503 when unset
KOKORO_API_URL="https://<kokoro-host>"
ELEVENLABS_API_KEY=""
